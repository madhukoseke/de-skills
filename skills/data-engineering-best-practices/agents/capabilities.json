{
  "schema_version": 1,
  "canonical_instruction_file": "SKILL.md",
  "providers": {
    "openai": {
      "adapter_file": "agents/openai.yaml",
      "build_output_dir": "dist/openai",
      "display_name": "OpenAI / Codex",
      "prompt_channel": "system",
      "api_family": "responses",
      "live_benchmark_supported": true,
      "api_key_env": "OPENAI_API_KEY",
      "model_env": "OPENAI_MODEL",
      "optimization": {
        "prompt_caching": "automatic",
        "prompt_caching_note": "Responses API caches prompts ≥1024 tokens automatically; identical prefixes hit the cache without explicit opt-in.",
        "structured_output": "json_schema"
      }
    },
    "anthropic": {
      "adapter_file": "agents/anthropic.yaml",
      "build_output_dir": "dist/anthropic",
      "display_name": "Anthropic / Claude",
      "prompt_channel": "system",
      "api_family": "messages",
      "live_benchmark_supported": true,
      "api_key_env": "ANTHROPIC_API_KEY",
      "model_env": "ANTHROPIC_MODEL",
      "optimization": {
        "prompt_caching": "ephemeral",
        "prompt_caching_note": "Wrap the canonical contract as a system block with `cache_control: {type: 'ephemeral'}`. Cuts input cost ~90% on repeated requests within the 5-minute TTL.",
        "structured_output": "tool_use"
      }
    },
    "gemini": {
      "adapter_file": "agents/gemini.yaml",
      "build_output_dir": "dist/gemini",
      "display_name": "Google Gemini",
      "prompt_channel": "system_instruction",
      "api_family": "generateContent",
      "live_benchmark_supported": true,
      "api_key_env": "GEMINI_API_KEY",
      "model_env": "GEMINI_MODEL",
      "optimization": {
        "prompt_caching": "context_cache",
        "prompt_caching_note": "Use the `cachedContents.create` endpoint to register the canonical contract, then reference the cache by name on subsequent generateContent calls.",
        "structured_output": "response_schema"
      }
    },
    "generic": {
      "adapter_file": "agents/generic.yaml",
      "build_output_dir": "dist/generic",
      "display_name": "Generic LLM Runtime",
      "prompt_channel": "system_or_developer",
      "api_family": "text_only",
      "live_benchmark_supported": false,
      "api_key_env": "",
      "model_env": "",
      "optimization": {
        "prompt_caching": "unsupported",
        "prompt_caching_note": "Cache the canonical bundle in your runtime's prompt assembly layer; the contract is static and SHA-pinned.",
        "structured_output": "markdown"
      }
    }
  }
}
