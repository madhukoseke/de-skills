{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madhukoseke/de-skills/schemas/skill_response.schema.json",
  "title": "DataEngineeringBestPracticesSkillResponse",
  "description": "Optional JSON mirror of the markdown output contract in SKILL.md (Summary, Decision, Rationale, Trade-offs, Next Steps, Template).",
  "type": "object",
  "additionalProperties": true,
  "required": ["summary", "decision", "rationale", "nextSteps"],
  "properties": {
    "summary": {
      "type": "string",
      "description": "One-paragraph executive summary."
    },
    "decision": {
      "type": "string",
      "description": "Specific recommendation with clear action items."
    },
    "rationale": {
      "type": "string",
      "description": "Why this approach over alternatives."
    },
    "tradeOffs": {
      "type": "array",
      "description": "Optional rows mirroring the Trade-offs markdown table.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["option", "pros", "cons", "whenToUse"],
        "properties": {
          "option": { "type": "string" },
          "pros": { "type": "string" },
          "cons": { "type": "string" },
          "whenToUse": { "type": "string" }
        }
      }
    },
    "costEstimate": {
      "type": "string",
      "description": "Storage/compute estimate when applicable."
    },
    "nextSteps": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Numbered actions the user can execute immediately."
    },
    "template": {
      "type": "string",
      "description": "Path under templates/ or short name of the filled template."
    }
  }
}
